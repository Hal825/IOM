{
  "name": "openmontage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -n web,worker -c cyan,magenta \"npm run dev\" \"npm run worker\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx watch workers/video-worker.ts",
    "redis:up": "docker compose up -d",
    "redis:down": "docker compose down",
    "remotion:studio": "remotion studio remotion/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.487",
    "@remotion/cli": "4.0.487",
    "@remotion/renderer": "4.0.487",
    "bullmq": "^5.80.8",
    "ioredis": "^5.11.1",
    "msedge-tts": "^2.0.7",
    "music-metadata": "^11.14.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.487"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
