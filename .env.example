REDIS_HOST=localhost
REDIS_PORT=6379

# ── 文本 LLM 节点（research/proposal/script 共用）──
# 三者共用同一模型，追加式对话前缀一致 → DeepSeek 前缀缓存命中（命中价 ≈ miss 1/10）。
# LLM_TEXT_API_KEY=your_api_key_here
# LLM_TEXT_BASE_URL=https://api.deepseek.com/v1
# LLM_TEXT_MODEL=deepseek-v4-pro

# ── 前端 agent（把节点完整输出组织成自然语言，流式输出给用户，像 LLM 网页交互）──
# FRONTEND_AGENT=on             # 默认开；关闭/失败时用每节点确定性模板兜底（不调付费 API）
# AGENT_API_KEY=your_api_key_here
# AGENT_BASE_URL=https://api.deepseek.com/v1
# AGENT_LLM_MODEL=deepseek-v4-flash   # 未配置时回退 LLM_TEXT_*

# ── AI 素材生成（场景背景）──
# AI_ASSET_API_KEY=your_api_key_here
# AI_ASSET_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# AI_ASSET_MODEL=qwen-image-2.0

# ── AI 视频生成 ──
# AI_VIDEO_API_KEY=your_api_key_here
# AI_VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/video-generation/video-synthesis
# AI_VIDEO_MODEL=happyhorse-1.1-r2v
# AI_VIDEO_RESOLUTION=720P
# AI_VIDEO_CONCURRENCY=2          # 逐镜头视频生成并发窗口（默认 2）
# AI_VIDEO_STYLE_STRENGTH=0.85    # 与参考图风格相似度 0-1（默认 0.85）
# AI_VIDEO_MODE=claude            # 方案 B：视频生成由 Claude 手动生成（套餐 key 仅 Claude 可用，项目调用 403）
# ANTHROPIC_AUTH_TOKEN=sk-sp-...  # 套餐 API key（方案 B 生成脚本 scripts/claude-video-gen.ts 用）

# ── AI 语音合成（TTS）──
# AI_TTS_API_KEY=your_api_key_here
# AI_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# AI_TTS_MODEL=qwen3-tts-flash
# AI_TTS_VOICE=Cherry
# AI_TTS_SPEED=1.0

# ── OSS 对象存储（角色图上传，供视频 API 引用）──
# OSS_REGION=oss-cn-shenzhen
# OSS_BUCKET=openmontage
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
