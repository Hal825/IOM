REDIS_HOST=localhost
REDIS_PORT=6379

# ── AI 语音合成（Seed-Audio 1.0 / 豆包音频生成）──
# AI_TTS_API_KEY=your_api_key_here
# AI_TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/create
# AI_TTS_MODEL=seed-audio-1.0

# ── AI 素材生成（角色视图 + 场景背景）──
# AI_ASSET_API_KEY=your_api_key_here
# AI_ASSET_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AI_ASSET_MODEL=ep-xxxxxxxxxx-xxxxx

# ── AI 视频生成 ──
# AI_VIDEO_API_KEY=your_api_key_here
# AI_VIDEO_BASE_URL=https://api.example.com/v1
# AI_VIDEO_MODEL=your-video-model

# ── 调研节点（Research Node）── 文本分析与结构识别 ────
# RESEARCH_API_KEY=your_api_key_here
# RESEARCH_BASE_URL=https://api.deepseek.com/v1
# RESEARCH_LLM_MODEL=deepseek-v4-flash

# ── 提案节点（Proposal Node）── 分镜脚本与风格指南 ────
# PROPOSAL_API_KEY=your_api_key_here
# PROPOSAL_BASE_URL=https://api.deepseek.com/v1
# PROPOSAL_LLM_MODEL=deepseek-v4-flash
# PROPOSAL_DEFAULT_DURATION_PER_SCENE=8
# PROPOSAL_MAX_SCENES=15
